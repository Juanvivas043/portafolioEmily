# Copia este archivo a .env.local y rellénalo con las credenciales reales.
#
# SMTP_APP_PASSWORD NO es la contraseña de la cuenta de Google: es una
# «contraseña de aplicación» de 16 caracteres que se genera en
# https://myaccount.google.com/apppasswords y que requiere tener activada la
# verificación en dos pasos.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=emily.portafolio@gmail.com
SMTP_APP_PASSWORD=abcd efgh ijkl mnop

# Buzón que recibe los mensajes del formulario. Si se deja vacío, se usa SMTP_USER.
CONTACT_TO=emily.portafolio@gmail.com

# URL pública del sitio. Se usa en metadatos, canonical y sitemap.
NEXT_PUBLIC_SITE_URL=https://portafolio-emily.example.com
